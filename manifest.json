{
  "manifest_version": 3,
  "name": "Gaveta",
  "version": "0.5.0",
  "description": "Uma fila local para vídeos do YouTube™, sem abrir dezenas de abas.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
